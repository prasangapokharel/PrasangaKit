{
  "name": "prasanga-ui",
  "version": "1.5.0",
  "description": "Professional React Native UI Component Library - 45+ shadcn-inspired, fully-typed, theme-aware components with dark/light mode support",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "files": [
    "src/components",
    "src/lib",
    "src/styles",
    "src/index.ts",
    "README.md",
    "tsconfig.json"
  ],
  "keywords": [
    "react-native",
    "ui-components",
    "typescript",
    "theme",
    "dark-mode",
    "shadcn",
    "expo",
    "component-library"
  ],
  "author": "Prasanga Pokharel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:prasangapokharel/PrasangaKit.git"
  },
  "homepage": "https://prasangakit.smmv.shop",
  "api": {
    "endpoint": "https://prasangakit.smmv.shop",
    "docs": "https://prasangakit.smmv.shop/docs"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run type-check"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "clsx": "^2.0.0",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.5.1",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "preferGlobal": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./src/index.ts",
        "react-native": "./src/index.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      }
    }
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
